table Sales
	lineageTag: 7d315c59-b366-4fa0-bcf7-8d67c307d94e

	measure Tot_Sales_amt = SUM(Sales[SalesAmount])
		displayFolder: Sales_measure
		lineageTag: ed973c42-fc8b-4d77-bb9a-db3d1d9c1e93

		formatStringDefinition = "#,##0"

	measure PM_Sales =
			CALCULATE(
			                    [Tot_Sales_amt],
			                    DATEADD('Calendar'[Date],-1,MONTH)
			                    )
		formatString: 0
		displayFolder: Sales_measure
		lineageTag: ecd963cd-6282-40c9-8932-8d0d7e0c0ebd

